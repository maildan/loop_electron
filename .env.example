# Environment Variables for Loop Electron App
# Copy this file to .env.local and fill in your actual values

# Development Settings
NODE_ENV=development
ELECTRON_DEBUG=false

# Database Configuration
DATABASE_URL="file:./dev.db"
MONGODB_URI="mongodb://localhost:27017/loop-typing"
MONGODB_DATABASE="loop-typing"

# MongoDB Atlas Configuration (for production)
# MONGODB_ATLAS_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/"
# MONGODB_ATLAS_DATABASE="loop-typing-prod"

# Redis Configuration (optional)
# REDIS_URL="redis://localhost:6379"

# API Keys and Secrets
# Add your API keys here
# OPENAI_API_KEY=""
# GITHUB_TOKEN=""

# Logging Configuration
LOG_LEVEL=info
LOG_TO_FILE=true

# Performance Settings
ENABLE_GPU_ACCELERATION=true
MEMORY_OPTIMIZATION=true
ENABLE_NATIVE_MODULES=true

# Update Server Configuration
# AUTO_UPDATE_URL=""
# UPDATE_CHECK_INTERVAL=86400000

# Analytics and Telemetry
ENABLE_ANALYTICS=false
TELEMETRY_URL=""

# Development Features
ENABLE_DEV_TOOLS=true
ENABLE_HOT_RELOAD=true
ENABLE_SOURCE_MAPS=true

# Window Configuration
DEFAULT_WINDOW_WIDTH=1200
DEFAULT_WINDOW_HEIGHT=800
WINDOW_MIN_WIDTH=800
WINDOW_MIN_HEIGHT=600

# Keyboard Monitoring
ENABLE_GLOBAL_SHORTCUTS=true
KEYBOARD_MONITORING_INTERVAL=100

# Sync Configuration
SYNC_INTERVAL=30000
OFFLINE_SYNC_ENABLED=true
CONFLICT_RESOLUTION_STRATEGY="client_wins"

# Security Settings
ENABLE_CONTEXT_ISOLATION=true
ENABLE_NODE_INTEGRATION=false
ENABLE_REMOTE_MODULE=false
